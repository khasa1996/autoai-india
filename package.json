{
  "name": "autoai-india-greenfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "braces": "3.0.3",
    "node-forge": "1.4.0",
    "react-native": "0.86.3",
    "sprintf-js": "1.1.3",
    "uuid": "11.1.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.mts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "dev:mobile": "npm run start --workspace @autoai/mobile",
    "dev:api": "tsx services/api/src/server.ts",
    "build": "npm run build:api && npm run build:web && npm run build:mobile",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "next build apps/web",
    "build:mobile": "npm run export --workspace @autoai/mobile",
    "start": "node dist/services/api/src/server.js",
    "start:web": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:assets-browser": "tsx tests/assets-browser/run.ts",
    "test:web-browser": "tsx tests/web-browser/run.ts",
    "test:mobile-browser": "tsx tests/mobile-browser/run.ts",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "esbuild": "0.28.2",
    "react-native": "0.86.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.4"
  }
}
